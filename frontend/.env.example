# ═══════════════════════════════════════════════════════════════════════════
# Rodeo — Environment Variables Template
# Copy to .env.local and fill in values for your environment (staging/prod)
# ═══════════════════════════════════════════════════════════════════════════

# ── Firebase Auth (Client — baked at build time) ─────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (Server — runtime) ────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CREDENTIALS_BASE64=
FIREBASE_ADMIN_IMPERSONATE_SA=

# ── GCP Cloud SQL PostgreSQL ─────────────────────────────────────────────
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=

# ── GCP Services ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GCS_BUCKET_NAME=

# ── Satellite Services ───────────────────────────────────────────────────
TITILER_URL=

# ── Email — Resend ───────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rodeoagtech.com

# ── Email Routing ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@rodeoagtech.com
NEXT_PUBLIC_SALES_EMAIL=ventas@rodeoagtech.com
NEXT_PUBLIC_PRESS_EMAIL=prensa@rodeoagtech.com
CONTACT_FORM_DESTINATION_EMAILS=

# ── JWT Auth ─────────────────────────────────────────────────────────────
EMAIL_VERIFY_JWT_SECRET=

# ── Payments (Mercado Pago) ──────────────────────────────────────────────
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_PARSER_URL=/api/parser
