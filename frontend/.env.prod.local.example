# ═══════════════════════════════════════════════════════════════════════
# Rodeo — Production Environment Variables (LOCAL USE ONLY)
# Copy this to .env.prod.local and fill in your production values.
# .env.prod.local is gitignored and should NEVER be committed.
# ═══════════════════════════════════════════════════════════════════════

# ── GCP Cloud SQL — Producción ────────────────────────────────────────
# Conectar vía Cloud SQL Auth Proxy: ./start_proxy_prod.sh
# Luego usar localhost aquí:
DATABASE_URL_PROD="postgresql://rodeo_app:YOUR_PROD_APP_PASSWORD@localhost:5432/rodeo_main"
DATABASE_URL_SERVICE_PROD="postgresql://rodeo_service:YOUR_PROD_SERVICE_PASSWORD@localhost:5432/rodeo_main"

# ── Firebase Auth (Producción) ────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rodeo-app-prod-v1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK ────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=rodeo-app-prod-v1
FIREBASE_ADMIN_CREDENTIALS_BASE64=

# ── Mercado Pago Production ──────────────────────────────────────────
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
