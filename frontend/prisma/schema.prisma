generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SubscriptionPlan {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(255)
  price         Decimal        @db.Decimal(10, 2)
  priceArs      Decimal?       @map("price_ars") @db.Decimal(10, 2)
  priceUsd      Decimal?       @map("price_usd") @db.Decimal(10, 2)
  priceYearly   Decimal?       @map("price_yearly") @db.Decimal(10, 2)
  slug          String         @unique @db.Text
  description   String?        @db.Text
  color         String?        @db.Text
  isPopular     Boolean?       @default(false) @map("is_popular")
  sortOrder     Int?           @default(0) @map("sort_order")
  trialDays     Int?           @default(14) @map("trial_days")
  paddocksLimit Int?           @default(5) @map("paddocks_limit")
  herdsLimit    Int?           @default(1) @map("herds_limit")
  hasAiAnalysis Boolean        @default(false) @map("has_ai_analysis")
  billingPeriod String?        @default("monthly") @map("billing_period")
  stripePriceId String?        @map("stripe_price_id") @db.VarChar(255)
  stripePriceIdMonthly String? @map("stripe_price_id_monthly") @db.Text
  stripePriceIdYearly  String? @map("stripe_price_id_yearly") @db.Text
  mpPlanId      String?        @map("mp_plan_id") @db.VarChar(255)
  mpPreapprovalPlanId  String? @map("mp_preapproval_plan_id") @db.Text
  isActive      Boolean        @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at")
  organizations     Organization[]
  payments          Payment[]
  planFeatureFlags  PlanFeatureFlag[]

  @@map("subscriptions_plans")
}

model Organization {
  id                       String            @id @default(uuid()) @db.Uuid
  // owner_id es VARCHAR(255) en la DB (creado antes de la FK constraint)
  ownerId                  String?           @map("owner_id") @db.VarChar(255)
  name                     String            @db.VarChar(255)
  totalAreaHa              Decimal?          @map("total_area_ha") @db.Decimal(10, 2)
  totalArea                Decimal?          @map("total_area") @db.Decimal(10, 2)
  regionId                 String?           @map("region_id") @db.VarChar(50)
  droughtPlanBuffer        Int?              @default(20) @map("drought_plan_buffer")
  subscriptionPlanId       String?           @map("subscription_plan_id") @db.Uuid
  // plan_status es TEXT en la DB (sin cast)
  planStatus               String?           @default("active") @map("plan_status") @db.Text
  trialEndsAt              DateTime?         @map("trial_ends_at") @db.Timestamptz
  planExpiresAt            DateTime?         @map("plan_expires_at") @db.Timestamptz
  stripeCustomerId         String?           @map("stripe_customer_id") @db.Text
  stripeSubscriptionId     String?           @map("stripe_subscription_id") @db.Text
  mpSubscriptionId         String?           @map("mp_subscription_id") @db.Text
  address                  String?           @db.Text
  locationLabel            String?           @map("location_label") @db.Text
  defaultDailyAllocationKg Decimal?          @default(12) @map("default_daily_allocation_kg") @db.Decimal(10, 2)
  defaultTargetRemnantKgHa Decimal?          @default(600) @map("default_target_remnant_kg_ha") @db.Decimal(10, 2)
  technicalData            Json?             @default("{}") @map("technical_data")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  subscriptionPlan         SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  profiles                 Profile[]
  paddocks                 Paddock[]
  herds                    Herd[]
  rainfallLogs             RainfallLog[]
  weatherEvents            WeatherEvent[]
  payments                 Payment[]
  farmEvents               FarmEvent[]
  tasks                    Task[]
  climateProjections       ClimateProjection[]
  movements                Movement[]

  @@map("organizations")
}

model Profile {
  id                   String                 @id @db.Uuid
  organizationId       String?                @map("organization_id") @db.Uuid
  firebaseUid          String?                @unique @map("firebase_uid")
  email                String?                @unique @db.VarChar(255)
  role                 String?                @db.VarChar(50)
  isActive             Boolean?               @default(true) @map("is_active")
  firstName            String?                @map("first_name") @db.VarChar(255)
  lastName             String?                @map("last_name") @db.VarChar(255)
  phone                String?                @db.VarChar(50)
  avatarUrl            String?                @map("avatar_url") @db.Text
  teamRole             String?                @map("team_role") @db.VarChar(50)
  permissions          Json?
  notificationPreferences Json?               @map("notification_preferences")
  isFirstLogin         Boolean?               @default(true) @map("is_first_login")
  // system_role es TEXT en la DB (sin VarChar constraint)
  systemRole           String?                @map("system_role") @db.Text
  onboardingStep       Int?                   @default(0) @map("onboarding_step")
  completedTours       String[]               @default([]) @map("completed_tours")
  countryCode          String?                @map("country_code") @db.VarChar(2)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  organization         Organization?          @relation(fields: [organizationId], references: [id])
  biologicalMonitoring BiologicalMonitoring[]
  rainfallLogs         RainfallLog[]
  weatherEvents        WeatherEvent[]
  tasks                Task[]
  termsAcceptances     UserTermsAcceptance[]

  @@map("profiles")
}

model Paddock {
  id                   String                 @id @default(uuid()) @db.Uuid
  orgId                String                 @map("org_id") @db.Uuid
  name                 String                 @db.VarChar(255)
  areaHa               Decimal?               @map("area_ha") @db.Decimal(10, 2)
  isGrazable           Boolean?               @default(true) @map("is_grazable")
  currentStatus        String?                @default("RESTING") @map("current_status")
  estimatedAdh         Decimal?               @default(0) @map("estimated_adh") @db.Decimal(10, 2)
  version              Int                    @default(1)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  organization         Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grazingPlans         GrazingPlan[]
  biologicalMonitoring BiologicalMonitoring[]
  weatherEvents        WeatherEventPaddock[]

  @@map("paddocks")
}

model Herd {
  id                     String        @id @default(uuid()) @db.Uuid
  orgId                  String        @map("org_id") @db.Uuid
  name                   String        @db.VarChar(255)
  species                String?       @default("Bovine") @db.VarChar(100)
  breed                  String?       @db.VarChar(100)
  category               String?       @db.VarChar(100)
  headCount              Int           @default(0) @map("head_count")
  avgWeightKg            Decimal?      @map("avg_weight_kg") @db.Decimal(10, 2)
  totalEv                Decimal?      @map("total_ev") @db.Decimal(10, 2)
  /// Estado fisiológico/biológico del rodeo (governs dynamic EV calculation)
  /// Values: VACA_CON_TERNERO | VACA_PRENADA | VACA_VACIA | TERNERO | RECRIA_NOVILLO
  physiologicalCategory  String?       @map("physiological_category") @db.VarChar(50)
  /// Fecha del último pesaje real registrado (base para proyección GDP)
  lastWeighDate          DateTime?     @map("last_weigh_date") @db.Date
  /// Ganancia Diaria de Peso en kg/día (para proyección de crecimiento)
  /// Obligatorio para TERNERO y RECRIA_NOVILLO; opcional para vacas (variación peso corporal)
  dailyGainKg            Decimal?      @map("daily_gain_kg") @db.Decimal(8, 3)
  version                Int           @default(1)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  organization           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grazingPlans           GrazingPlan[]

  @@map("herds")
}

model GrazingPlan {
  id                  String    @id @default(uuid()) @db.Uuid
  paddockId           String    @map("paddock_id") @db.Uuid
  herdId              String    @map("herd_id") @db.Uuid
  herdIds             Json?     @map("herd_ids")
  entryDate           DateTime  @map("entry_date") @db.Date
  exitDate            DateTime? @map("exit_date") @db.Date
  actualEntryDate     DateTime? @map("actual_entry_date") @db.Date
  actualExitDate      DateTime? @map("actual_exit_date") @db.Date
  plannedRecoveryDays Int?      @map("planned_recovery_days")
  status              String?   @default("PLANNED")
  actualAdhConsumed   Decimal?  @default(0) @map("actual_adh_consumed") @db.Decimal(10, 2)
  temporaryAnimals    Json?     @map("temporary_animals")
  notes               String?   @db.Text
  exitNotes           String?   @map("exit_notes") @db.Text
  exitDryMatterKgHa   Decimal?  @map("exit_dry_matter_kg_ha") @db.Decimal(10, 2)
  aiAnalysis          Json?     @map("ai_analysis")
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  paddock             Paddock   @relation(fields: [paddockId], references: [id], onDelete: Cascade)
  herd                Herd      @relation(fields: [herdId], references: [id], onDelete: Cascade)

  @@map("grazing_plans")
}

model BiologicalMonitoring {
  id                  String   @id @default(uuid()) @db.Uuid
  paddockId           String   @map("paddock_id") @db.Uuid
  observerId          String?  @map("observer_id") @db.Uuid
  photoUrl            String?  @map("photo_url")
  groundCoverPct      Decimal? @map("ground_cover_pct") @db.Decimal(5, 2)
  grassHeightCm       Decimal? @map("grass_height_cm") @db.Decimal(10, 2)
  dryMatterEstimateKg Decimal? @map("dry_matter_estimate_kg") @db.Decimal(10, 2)
  recordedAt          DateTime @default(now()) @map("recorded_at")
  createdAt           DateTime @default(now()) @map("created_at")
  paddock             Paddock  @relation(fields: [paddockId], references: [id], onDelete: Cascade)
  observer            Profile? @relation(fields: [observerId], references: [id], onDelete: SetNull)

  @@map("biological_monitoring")
}

model RainfallLog {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  recorderId   String?      @map("recorder_id") @db.Uuid
  date         DateTime     @db.Date
  mmCount      Decimal      @map("mm_count") @db.Decimal(10, 2)
  createdAt    DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recorder     Profile?     @relation(fields: [recorderId], references: [id], onDelete: SetNull)

  @@map("rainfall_logs")
}

// ── Nuevo modelo de eventos climáticos con relación M2M a Potreros ────────────

model WeatherEvent {
  id           String                @id @default(uuid()) @db.Uuid
  orgId        String                @map("org_id") @db.Uuid
  recorderId   String?               @map("recorder_id") @db.Uuid
  type         String                @db.VarChar(10) // "RAIN" | "FROST"
  value        Decimal               @db.Decimal(10, 2) // mm para lluvia, °C para helada
  date         DateTime              @db.Date
  notes        String?               @db.Text
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recorder     Profile?              @relation(fields: [recorderId], references: [id], onDelete: SetNull)
  paddocks     WeatherEventPaddock[]

  @@map("weather_events")
}

model WeatherEventPaddock {
  weatherEventId String       @map("weather_event_id") @db.Uuid
  paddockId      String       @map("paddock_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  weatherEvent   WeatherEvent @relation(fields: [weatherEventId], references: [id], onDelete: Cascade)
  paddock        Paddock      @relation(fields: [paddockId], references: [id], onDelete: Cascade)

  @@id([weatherEventId, paddockId])
  @@map("weather_event_paddocks")
}

model Payment {
  id                 String            @id @default(uuid()) @db.Uuid
  orgId              String            @map("org_id") @db.Uuid
  ownerId            String?           @map("owner_id") @db.Uuid
  provider           String            @db.VarChar(20)
  providerCustomerId String?           @map("provider_customer_id") @db.VarChar(255)
  providerSubId      String?           @map("provider_sub_id") @db.VarChar(255)
  providerPaymentId  String?           @map("provider_payment_id") @db.VarChar(255)
  planId             String?           @map("plan_id") @db.Uuid
  status             String?           @default("pending")
  amount             Decimal           @db.Decimal(10, 2)
  currency           String            @default("USD") @db.VarChar(3)
  billingPeriodStart DateTime?         @map("billing_period_start")
  billingPeriodEnd   DateTime?         @map("billing_period_end")
  nextBillingDate    DateTime?         @map("next_billing_date")
  cardBrand          String?           @map("card_brand") @db.VarChar(20)
  cardLastFour       String?           @map("card_last_four") @db.VarChar(4)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  organization       Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@map("payments")
}

model FarmEvent {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  title            String       @db.VarChar(255)
  eventType        String       @map("event_type") @db.VarChar(50)
  description      String?      @db.Text
  eventDate        DateTime     @map("event_date") @db.Date
  endDate          DateTime?    @map("end_date") @db.Date
  status           String       @default("pending") @db.VarChar(50)
  relatedHerdId    String?      @map("related_herd_id") @db.Uuid
  relatedPaddockId String?      @map("related_paddock_id") @db.Uuid
  impacts          Json?
  version          Int          @default(1)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("farm_events")
}

model Task {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  assigneeId   String?      @map("assignee_id") @db.Uuid
  title        String       @db.VarChar(255)
  description  String?      @db.Text
  status       String       @default("pending") @db.VarChar(50)
  dueDate      DateTime?    @map("due_date")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee     Profile?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model TermsAndConditionsVersion {
  id            String   @id @default(uuid()) @db.Uuid
  versionNumber String   @map("version_number") @db.VarChar(50)
  content       String   @db.Text
  isActive      Boolean  @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  acceptances UserTermsAcceptance[]

  @@map("terms_and_conditions_versions")
}

model UserTermsAcceptance {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  versionId  String   @map("version_id") @db.Uuid
  acceptedAt DateTime @default(now()) @map("accepted_at")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)

  profile Profile                   @relation(fields: [profileId], references: [id])
  version TermsAndConditionsVersion @relation(fields: [versionId], references: [id])

  @@map("user_terms_acceptances")
}

// ── Movimientos ganaderos ──────────────────────────────────────────────────────
model Movement {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  entityType    String       @map("entity_type") @db.Text
  entityId      String       @map("entity_id") @db.Uuid
  entityName    String?      @map("entity_name") @db.Text
  eventType     String       @map("event_type") @db.Text
  quantity      Int?
  weightKg      Decimal?     @map("weight_kg") @db.Decimal(10, 2)
  bcsScore      Decimal?     @map("bcs_score") @db.Decimal(5, 2)
  categoria     String?      @db.Text
  breed         String?      @db.Text
  admissionDate DateTime?    @map("admission_date") @db.Date
  notes         String?      @db.Text
  metadata      Json?        @default("{}")
  createdBy     String?      @map("created_by") @db.Uuid
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("movements")
}

// ── Proyecciones climáticas ────────────────────────────────────────────────────
model ClimateProjection {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectedAt    DateTime     @default(now()) @map("projected_at") @db.Timestamptz
  series         Json
  meta           Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("climate_projections")
}

// ── Feature flags por plan ─────────────────────────────────────────────────────
model PlanFeatureFlag {
  id       String           @id @default(uuid()) @db.Uuid
  planId   String           @map("plan_id") @db.Uuid
  flagKey  String           @map("flag_key") @db.Text
  flagValue Json            @map("flag_value")
  label    String?          @db.Text
  flagType String?          @default("boolean") @map("flag_type") @db.Text
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, flagKey])
  @@map("plan_feature_flags")
}

// ── Feature flags globales del sistema ────────────────────────────────────────
model SystemFeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  flagKey     String   @unique @map("flag_key") @db.VarChar(80)
  flagType    String   @default("boolean") @map("flag_type") @db.VarChar(20)
  flagValue   Json     @default("true") @map("flag_value")
  description String?  @db.Text
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_feature_flags")
}
