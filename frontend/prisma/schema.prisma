generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SubscriptionPlan {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(255)
  price          Decimal        @db.Decimal(10, 2)
  priceArs       Decimal?       @db.Decimal(10, 2)  @map("price_ars")
  priceUsd       Decimal?       @db.Decimal(10, 2)  @map("price_usd")
  paddocksLimit  Int?           @default(5)          @map("paddocks_limit")
  herdsLimit     Int?           @default(1)          @map("herds_limit")
  hasAiAnalysis  Boolean        @default(false)      @map("has_ai_analysis")
  billingPeriod  String?        @default("monthly")  @map("billing_period")
  stripePriceId  String?        @db.VarChar(255)     @map("stripe_price_id")
  mpPlanId       String?        @db.VarChar(255)     @map("mp_plan_id")
  isActive       Boolean        @default(true)       @map("is_active")
  createdAt      DateTime       @default(now())      @map("created_at")
  organizations  Organization[]
  payments       Payment[]

  @@map("subscriptions_plans")
}

model Organization {
  id                   String            @id @default(uuid()) @db.Uuid
  ownerId              String            @db.Uuid              @map("owner_id")
  name                 String            @db.VarChar(255)
  totalAreaHa          Decimal?          @db.Decimal(10, 2)   @map("total_area_ha")
  regionId             String?           @db.VarChar(50)      @map("region_id")
  droughtPlanBuffer    Int?              @default(20)         @map("drought_plan_buffer")
  subscriptionPlanId   String?           @db.Uuid             @map("subscription_plan_id")
  createdAt            DateTime          @default(now())      @map("created_at")
  updatedAt            DateTime          @updatedAt           @map("updated_at")
  subscriptionPlan     SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  profiles             Profile[]
  paddocks             Paddock[]
  herds                Herd[]
  rainfallLogs         RainfallLog[]
  payments             Payment[]

  @@map("organizations")
}

model Profile {
  id              String        @id @db.Uuid
  organizationId  String?       @db.Uuid              @map("organization_id")
  firebaseUid     String?       @unique               @map("firebase_uid")
  role            String?       @db.VarChar(50)
  isActive        Boolean?      @default(true)        @map("is_active")
  firstName       String?       @db.VarChar(255)      @map("first_name")
  lastName        String?       @db.VarChar(255)      @map("last_name")
  onboardingStep  Int?          @default(0)           @map("onboarding_step")
  countryCode     String?       @db.VarChar(2)        @map("country_code")
  createdAt       DateTime      @default(now())       @map("created_at")
  updatedAt       DateTime      @updatedAt            @map("updated_at")
  organization    Organization? @relation(fields: [organizationId], references: [id])
  biologicalMonitoring BiologicalMonitoring[]
  rainfallLogs    RainfallLog[]

  @@map("profiles")
}

model Paddock {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @db.Uuid              @map("org_id")
  name            String       @db.VarChar(255)
  areaHa          Decimal?     @db.Decimal(10, 2)   @map("area_ha")
  isGrazable      Boolean?     @default(true)        @map("is_grazable")
  currentStatus   String?      @default("RESTING")   @map("current_status")
  estimatedAdh    Decimal?     @default(0) @db.Decimal(10, 2) @map("estimated_adh")
  createdAt       DateTime     @default(now())       @map("created_at")
  updatedAt       DateTime     @updatedAt            @map("updated_at")
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grazingPlans    GrazingPlan[]
  biologicalMonitoring BiologicalMonitoring[]

  @@map("paddocks")
}

model Herd {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @db.Uuid              @map("org_id")
  name          String       @db.VarChar(255)
  species       String?      @default("Bovine")    @db.VarChar(100)
  breed         String?      @db.VarChar(100)
  category      String?      @db.VarChar(100)
  headCount     Int          @default(0)           @map("head_count")
  avgWeightKg   Decimal?     @db.Decimal(10, 2)   @map("avg_weight_kg")
  totalEv       Decimal?     @db.Decimal(10, 2)   @map("total_ev")
  createdAt     DateTime     @default(now())       @map("created_at")
  updatedAt     DateTime     @updatedAt            @map("updated_at")
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grazingPlans  GrazingPlan[]

  @@map("herds")
}

model GrazingPlan {
  id                   String    @id @default(uuid()) @db.Uuid
  paddockId            String    @db.Uuid              @map("paddock_id")
  herdId               String    @db.Uuid              @map("herd_id")
  entryDate            DateTime  @db.Date              @map("entry_date")
  exitDate             DateTime? @db.Date              @map("exit_date")
  plannedRecoveryDays  Int?                            @map("planned_recovery_days")
  status               String?   @default("PLANNED")
  actualAdhConsumed    Decimal?  @default(0) @db.Decimal(10, 2) @map("actual_adh_consumed")
  createdAt            DateTime  @default(now())       @map("created_at")
  updatedAt            DateTime  @updatedAt            @map("updated_at")
  paddock              Paddock   @relation(fields: [paddockId], references: [id], onDelete: Cascade)
  herd                 Herd      @relation(fields: [herdId], references: [id], onDelete: Cascade)

  @@map("grazing_plans")
}

model BiologicalMonitoring {
  id                    String    @id @default(uuid()) @db.Uuid
  paddockId             String    @db.Uuid              @map("paddock_id")
  observerId            String?   @db.Uuid              @map("observer_id")
  photoUrl              String?                         @map("photo_url")
  groundCoverPct        Decimal?  @db.Decimal(5, 2)    @map("ground_cover_pct")
  grassHeightCm         Decimal?  @db.Decimal(10, 2)   @map("grass_height_cm")
  dryMatterEstimateKg   Decimal?  @db.Decimal(10, 2)   @map("dry_matter_estimate_kg")
  recordedAt            DateTime  @default(now())       @map("recorded_at")
  createdAt             DateTime  @default(now())       @map("created_at")
  paddock               Paddock   @relation(fields: [paddockId], references: [id], onDelete: Cascade)
  observer              Profile?  @relation(fields: [observerId], references: [id], onDelete: SetNull)

  @@map("biological_monitoring")
}

model RainfallLog {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid              @map("org_id")
  recorderId  String?   @db.Uuid              @map("recorder_id")
  date        DateTime  @db.Date
  mmCount     Decimal   @db.Decimal(10, 2)   @map("mm_count")
  createdAt   DateTime  @default(now())       @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recorder     Profile?  @relation(fields: [recorderId], references: [id], onDelete: SetNull)

  @@map("rainfall_logs")
}

model Payment {
  id                  String    @id @default(uuid()) @db.Uuid
  orgId               String    @db.Uuid              @map("org_id")
  ownerId             String    @db.Uuid              @map("owner_id")
  provider            String    @db.VarChar(20)
  providerCustomerId  String?   @db.VarChar(255)      @map("provider_customer_id")
  providerSubId       String?   @db.VarChar(255)      @map("provider_sub_id")
  providerPaymentId   String?   @db.VarChar(255)      @map("provider_payment_id")
  planId              String?   @db.Uuid              @map("plan_id")
  status              String?   @default("pending")
  amount              Decimal   @db.Decimal(10, 2)
  currency            String    @default("USD")       @db.VarChar(3)
  billingPeriodStart  DateTime?                       @map("billing_period_start")
  billingPeriodEnd    DateTime?                       @map("billing_period_end")
  nextBillingDate     DateTime?                       @map("next_billing_date")
  cardBrand           String?   @db.VarChar(20)       @map("card_brand")
  cardLastFour        String?   @db.VarChar(4)        @map("card_last_four")
  createdAt           DateTime  @default(now())       @map("created_at")
  updatedAt           DateTime  @updatedAt            @map("updated_at")
  organization        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan                SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@map("payments")
}
