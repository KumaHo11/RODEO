rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny all access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Only allow authenticated users to read and write their own folders
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Organizations folder:
    //   READ  → cualquier usuario autenticado (los datos no son sensibles).
    //   WRITE → BLOQUEADO. Todos los uploads pasan por /api/upload (server-side)
    //           donde se valida la membresía a la organización antes de emitir
    //           la URL firmada. Esto evita que un usuario de la Org A escriba
    //           archivos en la Org B.
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Public assets
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
    }
  }
}
